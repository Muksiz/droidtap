#!/bin/bash
set -euo pipefail

AVD=droid
AVD_DIR="$ANDROID_AVD_HOME/$AVD.avd"
CONFIG="$AVD_DIR/config.ini"

set_ini() {
    if grep -q "^$1=" "$CONFIG"; then
        sed -i "s|^$1=.*|$1=$2|" "$CONFIG"
    else
        echo "$1=$2" >> "$CONFIG"
    fi
}

if [ ! -f "$CONFIG" ]; then
    echo "Creating AVD '$AVD' from $ANDROID_IMAGE"
    echo no | avdmanager create avd -n "$AVD" -k "$ANDROID_IMAGE" -d pixel_6
    set_ini PlayStore.enabled true
    set_ini hw.keyboard yes
    set_ini hw.audioInput no
    set_ini hw.audioOutput yes
    set_ini showDeviceFrame no
    set_ini disk.dataPartition.size "$EMULATOR_DATA_SIZE"
    # A small screen keeps software rendering cheap; audio is what matters here.
    set_ini hw.lcd.width 720
    set_ini hw.lcd.height 1280
    set_ini hw.lcd.density 320
fi

# The emulator reads the place of its window from this file and writes it
# back when it stops, so the place is set at every start.
USER_INI="$AVD_DIR/emulator-user.ini"
touch "$USER_INI"
sed -i '/^window\.[xy] *=/d' "$USER_INI"
printf 'window.x = 0\nwindow.y = 0\n' >> "$USER_INI"

# The emulator opens its window no taller than 80% of the desktop, whatever
# scale it is told, but keeps a size the window is given afterwards. That
# is EMULATOR_SCALE percent of the Android screen, and without it the
# largest size the desktop has room for.
fit_window() {
    local desktop=${SCREEN%x*} width height by_width by_height scale window
    width=$(sed -n 's/^hw\.lcd\.width *= *//p' "$CONFIG")
    height=$(sed -n 's/^hw\.lcd\.height *= *//p' "$CONFIG")
    if [ -n "${EMULATOR_SCALE:-}" ]; then
        scale=$((EMULATOR_SCALE * 10))
    else
        # The window has a title bar above it and the emulator's toolbar
        # next to it.
        by_width=$(((${desktop%x*} - 60) * 1000 / width))
        by_height=$(((${desktop#*x} - 30) * 1000 / height))
        scale=$((by_width < by_height ? by_width : by_height))
    fi
    width=$((width * scale / 1000))
    height=$((height * scale / 1000))
    window=$(xdotool search --sync --onlyvisible --name '^Android Emulator' | head -n 1)
    # The emulator sets its own size once more, a moment after the window is
    # there, and rounds a size it is given to the shape of the Android screen.
    for _ in {1..20}; do
        eval "$(xdotool getwindowgeometry --shell "$window")"
        if [ $((height - HEIGHT)) -gt 2 ] || [ $((HEIGHT - height)) -gt 2 ]; then
            xdotool windowsize "$window" "$width" "$height"
        fi
        sleep 0.5
    done
}
# In a subshell, so that it is not left behind as a child of the emulator.
(fit_window &)

# Lock files survive an unclean stop and make the emulator refuse to start.
rm -rf "$AVD_DIR"/*.lock

# The recorder container talks to this adb server, so it must listen on the
# compose network (-a) and not only on localhost. The port is not published.
adb -a start-server

# The emulator's own sound output goes nowhere: the container has no audio
# device, and droidtap captures the audio inside Android instead.
export QEMU_AUDIO_DRV=none
# -feature -PlayStoreImage only removes the "Google Play" page from the
# emulator's settings window; the Play Store inside Android is unaffected.
# With the page present the emulator runs "adb shell dumpsys package ..."
# every 10 seconds, and forking a process of several GB freezes it for
# 100-200 ms each time.
exec emulator -avd "$AVD" \
    -memory "$EMULATOR_RAM_MB" -cores "$EMULATOR_CORES" \
    -gpu swangle_indirect \
    -feature -PlayStoreImage \
    -no-snapshot -no-boot-anim -no-metrics
